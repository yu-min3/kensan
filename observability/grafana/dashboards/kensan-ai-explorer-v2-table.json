{
  "uid": "kensan-ai-explorer-v2-table",
  "title": "Kensan - AI Explorer v2 (Table approach)",
  "description": "Approach 1: Table + Transformations for columnar interaction view",
  "tags": ["kensan", "ai", "interaction", "v2"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "outcome",
        "label": "Outcome",
        "type": "custom",
        "current": { "text": "All", "value": "" },
        "options": [
          { "text": "All", "value": "", "selected": true },
          { "text": "success", "value": "success", "selected": false },
          { "text": "max_turns_reached", "value": "max_turns_reached", "selected": false },
          { "text": "error", "value": "error", "selected": false }
        ],
        "query": "success,max_turns_reached,error",
        "includeAll": true,
        "allValue": "",
        "multi": false
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "description": "Enter a Trace ID to drill down into a specific interaction",
        "type": "textbox",
        "current": { "text": "", "value": "" },
        "options": [],
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Interaction List (Table + Transformations approach)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Interactions — Summary + User Input + Agent Response",
      "description": "Approach 1: Multiple LogQL queries merged by traceid to create a columnar view. Each row shows trace summary, user input preview, and agent response preview.",
      "type": "table",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 1 },
      "datasource": { "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [
              { "id": "custom.width", "value": 155 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "trace_id" },
            "properties": [
              { "id": "custom.width", "value": 140 },
              { "id": "custom.displayMode", "value": "color-text" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "outcome" },
            "properties": [
              { "id": "custom.width", "value": 110 },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "success": { "text": "success", "color": "green" } } },
                  { "type": "value", "options": { "error": { "text": "error", "color": "red" } } },
                  { "type": "value", "options": { "max_turns_reached": { "text": "max_turns", "color": "yellow" } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background-solid" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "turns" },
            "properties": [
              { "id": "custom.width", "value": 55 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "model" },
            "properties": [
              { "id": "custom.width", "value": 140 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "in_tokens" },
            "properties": [
              { "id": "custom.width", "value": 80 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "out_tokens" },
            "properties": [
              { "id": "custom.width", "value": 85 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "user_input" },
            "properties": [
              { "id": "custom.width", "value": 300 },
              { "id": "custom.displayMode", "value": "color-text" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "super-light-blue" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "agent_response" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-text" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "super-light-green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "tempo_link" },
            "properties": [
              { "id": "custom.width", "value": 70 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Tempo",
                    "url": "/explore?left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22queryType%22:%22traceql%22,%22query%22:%22${__data.fields.trace_id}%22%7D%5D%7D",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "{job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.complete` | outcome =~ `$outcome` | line_format `{\"trace_id\":\"{{.traceid}}\",\"outcome\":\"{{.outcome}}\",\"turns\":{{.total_turns}},\"in_tokens\":{{.total_input_tokens}},\"out_tokens\":{{.total_output_tokens}},\"tempo_link\":\"trace\"}`",
          "refId": "summary"
        },
        {
          "expr": "{job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.prompt` | line_format `{\"trace_id\":\"{{.traceid}}\",\"model\":\"{{.model}}\",\"user_input\":\"{{.user_message}}\"}`",
          "refId": "user_input"
        },
        {
          "expr": "{job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.turn` | turn_number = `1` | line_format `{\"trace_id\":\"{{.traceid}}\",\"agent_response\":\"{{.response_text}}\"}`",
          "refId": "agent_response"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "keepTime": true,
            "replace": true
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "id": true,
              "labels": true,
              "tsNs": true,
              "Line": true
            },
            "indexByName": {
              "Time": 0,
              "trace_id": 1,
              "outcome": 2,
              "turns": 3,
              "model": 4,
              "in_tokens": 5,
              "out_tokens": 6,
              "user_input": 7,
              "agent_response": 8,
              "tempo_link": 9
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Time", "desc": true }],
        "footer": { "show": false },
        "cellHeight": "sm"
      }
    },
    {
      "id": 101,
      "title": "Drill-down: Conversation Detail (set trace_id above)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "Conversation Events (All events for selected trace)",
      "description": "Shows all events (prompt, turns, tool calls) for the selected trace in a table with separate columns per event type.",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "datasource": { "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.width", "value": 155 }]
          },
          {
            "matcher": { "id": "byName", "options": "event" },
            "properties": [
              { "id": "custom.width", "value": 120 },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "agent.prompt": { "text": "USER", "color": "blue" } } },
                  { "type": "value", "options": { "agent.turn": { "text": "AGENT", "color": "green" } } },
                  { "type": "value", "options": { "agent.tool_call": { "text": "TOOL", "color": "orange" } } },
                  { "type": "value", "options": { "agent.complete": { "text": "COMPLETE", "color": "purple" } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background-solid" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "turn" },
            "properties": [{ "id": "custom.width", "value": 50 }]
          },
          {
            "matcher": { "id": "byName", "options": "tool" },
            "properties": [{ "id": "custom.width", "value": 160 }]
          },
          {
            "matcher": { "id": "byName", "options": "tokens" },
            "properties": [{ "id": "custom.width", "value": 120 }]
          },
          {
            "matcher": { "id": "byName", "options": "ok" },
            "properties": [
              { "id": "custom.width", "value": 40 },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "true": { "text": "✓", "color": "green" } } },
                  { "type": "value", "options": { "false": { "text": "✗", "color": "red" } } },
                  { "type": "value", "options": { "-": { "text": "-" } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-text" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "content" },
            "properties": [
              { "id": "custom.inspect", "value": true }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "{job=\"kensan-ai\"} | json | traceid =~ `$trace_id` | line_format `{{.body}}` | json | event = `agent.prompt` | line_format `{\"event\":\"agent.prompt\",\"turn\":\"-\",\"tool\":\"-\",\"tokens\":\"-\",\"ok\":\"-\",\"content\":\"{{.user_message}}\"}`",
          "refId": "prompt"
        },
        {
          "expr": "{job=\"kensan-ai\"} | json | traceid =~ `$trace_id` | line_format `{{.body}}` | json | event = `agent.turn` | line_format `{\"event\":\"agent.turn\",\"turn\":\"{{.turn_number}}\",\"tool\":\"-\",\"tokens\":\"in={{.input_tokens}} out={{.output_tokens}}\",\"ok\":\"-\",\"content\":\"{{.response_text}}\"}`",
          "refId": "turn"
        },
        {
          "expr": "{job=\"kensan-ai\"} | json | traceid =~ `$trace_id` | line_format `{{.body}}` | json | event = `agent.tool_call` | line_format `{\"event\":\"agent.tool_call\",\"turn\":\"-\",\"tool\":\"{{.tool_name}}\",\"tokens\":\"-\",\"ok\":\"{{.success}}\",\"content\":\"in={{.tool_input}} out={{.tool_output}}\"}`",
          "refId": "tool"
        },
        {
          "expr": "{job=\"kensan-ai\"} | json | traceid =~ `$trace_id` | line_format `{{.body}}` | json | event = `agent.complete` | line_format `{\"event\":\"agent.complete\",\"turn\":\"{{.total_turns}}\",\"tool\":\"-\",\"tokens\":\"total_in={{.total_input_tokens}} total_out={{.total_output_tokens}}\",\"ok\":\"{{.outcome}}\",\"content\":\"outcome={{.outcome}} pending_actions={{.pending_action_count}}\"}`",
          "refId": "complete"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "keepTime": true,
            "replace": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "id": true,
              "labels": true,
              "tsNs": true,
              "Line": true
            },
            "indexByName": {
              "Time": 0,
              "event": 1,
              "turn": 2,
              "tool": 3,
              "tokens": 4,
              "ok": 5,
              "content": 6
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Time", "desc": false }],
        "footer": { "show": false },
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "title": "Full User Input (selected trace)",
      "description": "Complete user message for the selected trace",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{job=\"kensan-ai\"} | json | traceid =~ `$trace_id` | line_format `{{.body}}` | json | event = `agent.prompt` | line_format `{{.user_message}}`",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Full Agent Response (selected trace)",
      "description": "Complete agent response text for each turn",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{job=\"kensan-ai\"} | json | traceid =~ `$trace_id` | line_format `{{.body}}` | json | event = `agent.turn` | line_format `[Turn {{.turn_number}}] {{.response_text}}`",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39
}
