{
  "uid": "kensan-ai-interaction-explorer",
  "title": "Kensan - AI Interaction Explorer",
  "description": "AI interaction flow: user input → agent processing → tool calls → output",
  "tags": ["kensan", "ai", "interaction"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "outcome",
        "label": "Outcome",
        "type": "custom",
        "current": { "text": "All", "value": "" },
        "options": [
          { "text": "All", "value": "", "selected": true },
          { "text": "success", "value": "success", "selected": false },
          { "text": "max_turns_reached", "value": "max_turns_reached", "selected": false },
          { "text": "error", "value": "error", "selected": false }
        ],
        "query": "success,max_turns_reached,error",
        "includeAll": true,
        "allValue": "",
        "multi": false
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "description": "Copy a Trace ID from the table below to drill down into a specific agent execution",
        "type": "textbox",
        "current": { "text": "", "value": "" },
        "options": [],
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Total Interactions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.complete` | outcome =~ `$outcome` [$__range]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Success Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.complete` | outcome = `success` [$__range]))",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.complete` [$__range]))",
          "legendFormat": "total",
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "reduce": { "reducer": "sum" },
            "binary": { "left": "success", "right": "total", "operator": "/" },
            "alias": "rate"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": { "include": { "names": ["rate"] } }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Avg Tokens / Interaction",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5000 },
              { "color": "orange", "value": 20000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg(avg_over_time({job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.complete` | unwrap total_input_tokens [$__range]))",
          "legendFormat": "input",
          "refId": "A"
        },
        {
          "expr": "avg(avg_over_time({job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.complete` | unwrap total_output_tokens [$__range]))",
          "legendFormat": "output",
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "reduce": { "reducer": "mean" },
            "binary": { "left": "input", "right": "output", "operator": "+" },
            "alias": "avg_total"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": { "include": { "names": ["avg_total"] } }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Avg Turns / Interaction",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "orange", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg(avg_over_time({job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.complete` | unwrap total_turns [$__range]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 101,
      "title": "Recent Interactions (copy Trace ID to drill down)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "title": "Recent Interactions",
      "description": "Each row = one agent execution (trace). Copy Trace ID to the variable above, then scroll down to see Conversation Flow and Tool Calls for that trace.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "datasource": { "uid": "loki" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.width", "value": 160 }]
          },
          {
            "matcher": { "id": "byName", "options": "traceid" },
            "properties": [
              { "id": "custom.width", "value": 270 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Trace in Tempo",
                    "url": "/explore?left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22queryType%22:%22traceql%22,%22query%22:%22${__value.raw}%22%7D%5D%7D",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "outcome" },
            "properties": [{ "id": "custom.width", "value": 130 }]
          },
          {
            "matcher": { "id": "byName", "options": "total_turns" },
            "properties": [{ "id": "custom.width", "value": 60 }]
          },
          {
            "matcher": { "id": "byName", "options": "total_input_tokens" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          },
          {
            "matcher": { "id": "byName", "options": "total_output_tokens" },
            "properties": [{ "id": "custom.width", "value": 110 }]
          }
        ]
      },
      "targets": [
        {
          "expr": "{job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.complete` | outcome =~ `$outcome` | line_format `{\"traceid\":\"{{.traceid}}\",\"outcome\":\"{{.outcome}}\",\"total_turns\":{{.total_turns}},\"total_input_tokens\":{{.total_input_tokens}},\"total_output_tokens\":{{.total_output_tokens}},\"pending_action_count\":{{.pending_action_count}}}`",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "id": true,
              "labels": true,
              "tsNs": true
            },
            "indexByName": {
              "Time": 0,
              "traceid": 1,
              "outcome": 2,
              "total_turns": 3,
              "total_input_tokens": 4,
              "total_output_tokens": 5,
              "pending_action_count": 6
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Time", "desc": true }],
        "footer": { "show": false }
      }
    },
    {
      "id": 102,
      "title": "Conversation Flow (filtered by Trace ID)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "title": "Conversation Flow",
      "description": "User input (>>>) and agent responses (<<<) in chronological order within the selected trace.",
      "type": "logs",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 17 },
      "datasource": { "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{job=\"kensan-ai\"} | json | traceid =~ `$trace_id` | line_format `{{.body}}` | json | event = `agent.prompt` | line_format `>>> USER [{{.model}}] {{.user_message}}`",
          "refId": "A"
        },
        {
          "expr": "{job=\"kensan-ai\"} | json | traceid =~ `$trace_id` | line_format `{{.body}}` | json | event = `agent.turn` | line_format `<<< AGENT [Turn {{.turn_number}}] tokens={{.input_tokens}}+{{.output_tokens}} tools={{.tool_call_count}} | {{.response_text}}`",
          "refId": "B"
        },
        {
          "expr": "{job=\"kensan-ai\"} | json | traceid =~ `$trace_id` | line_format `{{.body}}` | json | event = `agent.tool_call` | line_format `    TOOL [{{.tool_name}}] success={{.success}} in={{.tool_input}}`",
          "refId": "C"
        }
      ]
    },
    {
      "id": 103,
      "title": "Tool Execution Details (filtered by Trace ID)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "title": "Tool Calls",
      "description": "Tool name, input, output for each invocation within the selected trace",
      "type": "table",
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 34 },
      "datasource": { "uid": "loki" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.width", "value": 160 }]
          },
          {
            "matcher": { "id": "byName", "options": "tool_name" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          },
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "custom.width", "value": 70 }]
          }
        ]
      },
      "targets": [
        {
          "expr": "{job=\"kensan-ai\"} | json | traceid =~ `$trace_id` | line_format `{{.body}}` | json | event = `agent.tool_call`",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "id": true,
              "labels": true,
              "tsNs": true,
              "event": true,
              "conversation_id": true
            },
            "indexByName": {
              "Time": 0,
              "tool_name": 1,
              "tool_input": 2,
              "tool_output": 3,
              "success": 4
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Time", "desc": false }],
        "footer": { "show": false }
      }
    },
    {
      "id": 9,
      "title": "Tool Usage Distribution",
      "description": "Which tools are called most frequently",
      "type": "piechart",
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 34 },
      "datasource": { "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (tool_name) (count_over_time({job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.tool_call` [$__range]))",
          "legendFormat": "{{tool_name}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 104,
      "title": "Trace & Timing",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "title": "Agent Execution Traces",
      "description": "Click a trace to see the full waterfall: stream → turn → tool_execution",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 45 },
      "datasource": { "uid": "tempo" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{resource.service.name = \"kensan-ai\" && name = \"agent.stream\"}",
          "limit": 30
        }
      ]
    },
    {
      "id": 11,
      "title": "Execution Duration by Outcome",
      "description": "How long each agent execution took, colored by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 53 },
      "datasource": { "uid": "tempo" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{resource.service.name = \"kensan-ai\" && name = \"agent.stream\"} | select(duration, span.agent.outcome)",
          "limit": 100
        }
      ]
    },
    {
      "id": 12,
      "title": "Tool Execution Duration (per tool)",
      "description": "Time spent in each tool execution from traces",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 53 },
      "datasource": { "uid": "tempo" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "points",
            "pointSize": 6,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{resource.service.name = \"kensan-ai\" && name = \"agent.tool_execution\"} | select(duration, span.tool.name)",
          "limit": 200
        }
      ]
    },
    {
      "id": 105,
      "title": "Token Cost Analysis",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 61 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "title": "Token Usage Over Time",
      "description": "Input vs output token consumption",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 62 },
      "datasource": { "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": { "mode": "normal" },
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "input_tokens" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "output_tokens" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum_over_time({job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.complete` | unwrap total_input_tokens [$__interval])",
          "legendFormat": "input_tokens",
          "refId": "A"
        },
        {
          "expr": "sum_over_time({job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.complete` | unwrap total_output_tokens [$__interval])",
          "legendFormat": "output_tokens",
          "refId": "B"
        }
      ]
    },
    {
      "id": 14,
      "title": "Interactions Over Time",
      "description": "Interaction count by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 62 },
      "datasource": { "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": { "mode": "normal" },
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "max_turns_reached" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (outcome) (count_over_time({job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.complete` [$__interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 106,
      "title": "Error Investigation",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 70 },
      "collapsed": true,
      "panels": [
        {
          "id": 15,
          "title": "Error Logs",
          "description": "All error and warning logs from the AI service",
          "type": "logs",
          "gridPos": { "h": 10, "w": 24, "x": 0, "y": 71 },
          "datasource": { "uid": "loki" },
          "options": {
            "showTime": true,
            "showLabels": true,
            "showCommonLabels": false,
            "wrapLogMessage": true,
            "prettifyLogMessage": false,
            "enableLogDetails": true,
            "sortOrder": "Descending",
            "dedupStrategy": "none"
          },
          "targets": [
            {
              "expr": "{job=\"kensan-ai\", level=~\"error|warning\"}",
              "refId": "A"
            }
          ]
        },
        {
          "id": 16,
          "title": "Failed Tool Calls",
          "description": "Tool calls that returned errors",
          "type": "logs",
          "gridPos": { "h": 10, "w": 24, "x": 0, "y": 81 },
          "datasource": { "uid": "loki" },
          "options": {
            "showTime": true,
            "showLabels": false,
            "showCommonLabels": false,
            "wrapLogMessage": true,
            "prettifyLogMessage": false,
            "enableLogDetails": true,
            "sortOrder": "Descending",
            "dedupStrategy": "none"
          },
          "targets": [
            {
              "expr": "{job=\"kensan-ai\"} | json | line_format `{{.body}}` | json | event = `agent.tool_call` | success = `false` | line_format `[{{.tool_name}}] input={{.tool_input}} error={{.error}}`",
              "refId": "A"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 39
}
